io :: import "std/io"
Box :: struct { value: i64 }
make :: fn(v: i64) ref Box {
    b := new Box
    if b == nil { ret b }
    b.value = v
    ret b
}
main :: fn() {
    total: i64 = 0
    for i := 0; i < 10000000; i += 1 {
        b := make(cast(i64, i))
        if b == nil {
            io.println("alloc failed")
            ret
        }
        total += b.value + 1
        del b
    }
    io.println("result: {}", total)
}
