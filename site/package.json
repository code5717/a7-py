{
  "name": "a7-docs-site",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts && bun run build:css",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/assets/site.css --minify",
    "lint": "bun run scripts/lint.ts",
    "check": "bun run lint && bun run typecheck && bun run check:coverage && bun run test && bun run build && bun run check:exports && bun run check:links",
    "preview": "bun run scripts/serve.ts",
    "dev": "bun run build && bun run scripts/serve.ts",
    "test": "bun test scripts/*.test.ts",
    "sync:exports": "bun run scripts/exports.ts --write",
    "check:exports": "bun run scripts/exports.ts",
    "check:links": "bun run scripts/check-links.ts",
    "typecheck": "tsc --noEmit",
    "check:coverage": "python3 scripts/check-coverage.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "1.4.2",
    "@types/markdown-it": "14.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "markdown-it": "15.0.2"
  }
}
