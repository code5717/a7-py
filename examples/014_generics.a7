// Generic functions and structs

io :: import "std/io"

identity($T) :: fn(value: $T) $T {
    ret value
}

Box :: struct {
    value: $T
}

Pair($A, $B) :: struct {
    first: $A
    second: $B
}

larger :: fn(a: $T, b: $T) $T where T: Integer {
    ret if a > b { a } else { b }
}

main :: fn() {
    io.println("=== Generics ===")

    number := identity(7)
    word := identity("ok")
    boxed: Box(i32) = Box(i32){value: number}
    nested: Box(Box(i32)) = Box(Box(i32)){value: Box(i32){value: 5}}
    pair: Pair(i32, string) = Pair(i32, string){first: boxed.value, second: word}

    io.println("identity number = {}", number)
    io.println("identity string = {}", word)
    io.println("boxed = {}", boxed.value)
    io.println("nested boxed = {}", nested.value.value)
    io.println("pair = {} {}", pair.first, pair.second)

    signed_left: i32 = -4
    signed_right: i32 = 9
    unsigned_left: u16 = 300
    unsigned_right: u16 = 17
    io.println("larger signed = {}", larger(signed_left, signed_right))
    io.println("larger unsigned = {}", larger(unsigned_left, unsigned_right))
}
