+    def _summarize_call_effects(self, program: ASTNode) -> None:
+        """Compute per-function may-write sets over mutable globals (SAF-6).
+
+        Each file-scope function maps to the set of mutable-global names its
+        execution may assign or delete, expanded transitively over direct
+        calls, or to None when the effect is unbounded. Callee resolution is
+        by declaration identity: a call uses a summary only when the callee
+        is a bare identifier, no local binding of the enclosing function can
+        shadow the name, and the name resolves in the global scope to a
+        FUNCTION symbol whose declaration node has a summary. Everything
+        else (function values, module-qualified calls, shadowed or unknown
+        names) is unbounded. Stdlib calls carry `stdlib_canonical`, which the
+        type checker sets only through scoped symbol lookup, and compiler
+        stdlib cannot name a user global. The may-write sets are a monotone
+        fixpoint over a finite lattice, so the result stays sound even for a
+        call cycle that reached this pass.
+        """
+        declarations = program.declarations or []
