+    def _call_global_writes_in(self, statement: ASTNode) -> set[str]:
+        """Mutable globals written by calls inside a subtree (SAF-6).
+
+        Used where a scope exit or a loop entry must observe the callee's
+        effects: a deferred call runs before the scope's facts flow onward,
+        and a call in a loop body may run on any iteration. Unlike direct
+        assignments, these writes are not havoced at a `defer` registration
+        site, because the deferred call has not run there yet.
+        """
+        names: set[str] = set()
+        stack = [statement]
+        while stack:
+            current = stack.pop()
+            if current is None:
+                continue
+            if current.kind == NodeKind.FUNCTION:
+                continue
+            if current.kind == NodeKind.CALL:
+                written = self._resolved_global_writes(current)
+                if written is None:
+                    names |= self.global_var_names
+                else:
+                    names |= written
+            for value in vars(current).values():
+                if isinstance(value, ASTNode):
+                    stack.append(value)
+                elif isinstance(value, list):
+                    stack.extend(child for child in value if isinstance(child, ASTNode))
+        return names
