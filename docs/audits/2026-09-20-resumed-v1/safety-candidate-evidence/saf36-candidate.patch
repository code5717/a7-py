+    def _pattern_relation(
+        self,
+        pattern: ASTNode,
+        selector: ValueFact,
+        node: ASTNode,
+        saved: dict[str, ValueFact],
+    ) -> Optional[bool]:
+        """Relation between a case pattern and the selector value.
+
+        True when the pattern provably matches, False when it provably cannot
+        match, None when unknown. Unknown is never treated as a proven
+        impossible edge: an unknown relation leaves the case possible. The
+        selector snapshot comes from match entry because the backend
+        evaluates the scrutinee once.
+        """
+        if pattern.kind == NodeKind.PATTERN_WILDCARD:
+            return True
+        if pattern.kind == NodeKind.PATTERN_IDENTIFIER and (
+            pattern.name == "_" or getattr(pattern, "is_capture_pattern", False)
+        ):
+            return True
+        if pattern.kind == NodeKind.PATTERN_LITERAL:
+            literal = self._int_literal(pattern.literal)
+            interval = selector.interval
+            if literal is not None and interval is not None:
+                if interval.lower is not None and literal < interval.lower:
+                    return False
+                if interval.upper is not None and literal > interval.upper:
+                    return False
+                if interval.lower == interval.upper == literal:
+                    return True
+            return None
+        if pattern.kind == NodeKind.PATTERN_ENUM:
+            enum_type = self._type(node.expression)
+            enum_symbol = self.symbols.lookup(pattern.enum_type or "")
+            if (
+                isinstance(enum_type, EnumType)
+                and enum_symbol is not None
+                and enum_symbol.kind == SymbolKind.ENUM
+                and enum_symbol.type is enum_type
+                and pattern.enum_type not in saved
+                and enum_type.has_variant(pattern.variant)
+                and selector.enum_discriminant is not None
+            ):
+                return selector.enum_discriminant == f"{id(enum_type)}:{pattern.variant}"
+            return None
+        if pattern.kind == NodeKind.PATTERN_RANGE:
+            lower = self._int_literal(pattern.start.literal) if pattern.start and pattern.start.kind == NodeKind.PATTERN_LITERAL else None
+            upper = self._int_literal(pattern.end.literal) if pattern.end and pattern.end.kind == NodeKind.PATTERN_LITERAL else None
+            interval = selector.interval
+            if lower is not None and upper is not None and interval is not None:
+                if interval.upper is not None and interval.upper < lower:
+                    return False
+                if interval.lower is not None and interval.lower > upper:
+                    return False
+                if interval.lower is not None and interval.upper is not None and lower <= interval.lower <= interval.upper <= upper:
+                    return True
+            return None
+        return None
 
