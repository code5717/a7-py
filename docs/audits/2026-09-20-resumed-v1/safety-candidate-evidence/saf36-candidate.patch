+            decl.name for decl in declarations if decl.kind == NodeKind.VAR and decl.name
+        }
+        functions: dict[str, ASTNode] = {}
+        for decl in declarations:
+            if decl.kind == NodeKind.FUNCTION and decl.name and decl.name not in functions:
+                functions[decl.name] = decl
+        # Local binding names per function (parameters, variables, constants,
+        # nested function names, match captures). Nested functions inherit the
+        # enclosing names so a shadowed callee can never resolve to a global.
+        work = [(decl, set()) for decl in declarations if decl.kind == NodeKind.FUNCTION]
