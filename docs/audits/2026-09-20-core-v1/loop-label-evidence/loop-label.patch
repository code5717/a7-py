+"""Native loop transfer results, including labels with no transfers."""
+import pytest
+from test_zig_backend_runtime import build, compile_with_cli, run_piped, zig, zig_cache
+
+CASES = {
+    'unused-all-loop-forms': ('''io :: import "std/io"
+main :: fn() {
+    n: i32 = 0
+    @unused while n < 2 { n += 1 }
+    @unused for { n += 1; break }
+    @unused for j := 0; j < 2; j += 1 { n += 1; continue }
+    values: [2]i32 = [3, 4]
+    @unused for value in values { n += value }
+    @unused for index, value in values { io.println("{}:{}", index, value) }
+    io.println("{}", n)
+}
+''', '0:3\n1:4\n12\n'),
+    'targeted-and-reused-labels': ('''io :: import "std/io"
+step :: fn() i32 { io.println("step"); ret 1 }
+main :: fn() {
+    i: i32 = 0
+    @outer for i = 0; i < 4; step() {
+        @inner for {
+            io.println("body {}", i)
+            if i == 2 { break outer }
+            i += 1
+            continue outer
+        }
+    }
+    @same for { break }
+    @same for { break same }
+    @same for {
+        @same for { break same }
+        io.println("nearest")
+        break same
+    }
+    n: i32 = 0
+    @count while n < 3 { n += 1; continue count }
+    values: [2]i32 = [3, 4]
+    @items for value in values { io.println("item {}", value); break items }
+    @indexed for index, value in values {
+        if index == 0 { continue indexed }
+        io.println("indexed {}", value)
+    }
+    io.println("done {} {}", i, n)
+}
+''', 'body 0\nstep\nbody 1\nstep\nbody 2\nnearest\nitem 3\nindexed 4\ndone 2 3\n'),
+}
+
+@pytest.mark.parametrize('profile', ['Debug', 'ReleaseFast'])
+@pytest.mark.parametrize('source,expected', CASES.values(), ids=CASES.keys())
+def test_loop_labels_native(tmp_path, zig, zig_cache, profile, source, expected):
+    output = compile_with_cli(tmp_path, source)
+    binary = build(zig, zig_cache, tmp_path, output, profile)
+    assert run_piped(binary) == (expected, '')
